# Copy to deploy/staging/.env (gitignored). Never commit secrets.

POSTGRES_PASSWORD=change_me_staging_pg
NEO4J_PASSWORD=password
TUNNEL_TOKEN=

# Optional: local sqlite with CRE + CRE embeddings for hub sync into Postgres
# (scripts/oie_sync_cre_hub.py). Not a live DB — file copied into the image or mounted.
# CRE_HUB_SQLITE=/code/standards_cache.sqlite

# Auth
NO_LOGIN=0
CRE_ENABLE_LOGIN=1
LOGIN_ALLOWED_DOMAINS=*
LOGIN_ALLOWED_EMAILS=spyros.gasteratos@owasp.org,rob.van.der.veer@owasp.org,rock.lambros@owasp.org
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT API tokens (HS256). Required under FLASK_CONFIG=production (env or persisted file).
# Prefer setting explicitly; else entrypoint may mint once into opencre_staging_secrets.
# API_TOKEN_JWT_SECRET=
# API_TOKEN_JWT_SECRET_FILE=/code/.secrets/api_token_jwt_secret
CRE_OIE_GA_VIA_QUEUE=1

# LLM / Nest
GEMINI_API_KEY=
NEST_API_KEY=
NEST_API_BASE=https://nest.owasp.org/api/v0

# Agent
OWASP_AGENT_ENABLED=1
CRE_ALLOW_IMPORT=1
CRE_ENABLE_HEALTH=1

# First boot: skip heavy upstream until DB is seeded (set 0 to sync on start)
CRE_SKIP_UPSTREAM_SYNC=1
CRE_EMBED_EXPECTED_DIM=3072

# Remote MCP (Compose service `mcp` on :5002). Staging only — never enable on Heroku/prod.
OPENCRE_MCP_REMOTE=1
# Host allowlist for Streamable HTTP DNS-rebinding protection (comma-separated).
# OPENCRE_MCP_ALLOWED_HOSTS=staging.opencre.org,staging.opencre.org:*

# Module C — promoted d1-winner stack (also set in docker-compose.yml).
# Override only for experiments; see docs/oie/feature-flags.md.
# CRE_LIBRARIAN_RETRIEVER_BACKEND=pgvector
# CRE_LIBRARIAN_MARGIN_GAMMA=0.85
# CRE_LIBRARIAN_SHORTLIST_JUDGE=1
# CRE_LIBRARIAN_SAFETY_GUARD=1
# CRE_LIBRARIAN_SAFETY_BATCH_SIZE=8
# CRE_LIBRARIAN_EDITION_REMAP_LIVE=0
# After hub sync, warm edition/neighbor caches once (no live Gemini on C path):
#   PYTHONPATH=. python scripts/oie_precompute_remap_caches.py --cache-file "$DEV_DATABASE_URL"
# Keep fail-closed accuracy levers off unless evaluating them:
# CRE_LIBRARIAN_PAIRWISE_VOTE=0
# CRE_LIBRARIAN_SOURCE_GROUNDING=0
# CRE_LIBRARIAN_CROSSWALK_CAGE=0
# CRE_LIBRARIAN_COVERAGE_FAIL_CLOSED=0
# Exhaustive drains that do not need graph filing: pass skip_c1=1 on Admin ingest.
