# Copy to deploy/staging/.env (gitignored). Never commit secrets.

POSTGRES_PASSWORD=change_me_staging_pg
TUNNEL_TOKEN=

# Auth
NO_LOGIN=0
CRE_ENABLE_LOGIN=1
LOGIN_ALLOWED_DOMAINS=*
LOGIN_ALLOWED_EMAILS=spyros.gasteratos@owasp.org,rob.van.der.veer@owasp.org,rock.lambros@owasp.org
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM / Nest
GEMINI_API_KEY=
NEST_API_KEY=
NEST_API_BASE=https://nest.owasp.org/api/v0

# Agent
OWASP_AGENT_ENABLED=1
CRE_ALLOW_IMPORT=1
CRE_ENABLE_HEALTH=1

# First boot: skip heavy upstream until DB is seeded (set 0 to sync on start)
CRE_SKIP_UPSTREAM_SYNC=1
CRE_EMBED_EXPECTED_DIM=3072
