# ------------------------------------------------------------------------------
# OpenCRE Environment Configuration
# ------------------------------------------------------------------------------
# Copy this file to `.env` and update the values for your environment.
# Never commit your real `.env` file to version control.
# ------------------------------------------------------------------------------
# Database
# Local Docker (make docker-postgres / make admin-local):
#   postgresql://cre:password@127.0.0.1:5432/cre
# `make admin-local` starts that container when the URL is unreachable and
# never falls back to SQLite for the admin showcase.

DEV_DATABASE_URL=postgresql://user:password@localhost:5432/opencre

# Neo4j

NEO4J_URL=neo4j://neo4j:password@localhost:7687

# Redis

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_NO_SSL=false

# Flask

FLASK_CONFIG=development
INSECURE_REQUESTS=false

# Feature Flags
# Enable the deploy/uptime health probe at GET /rest/v1/health.
# Set to one of 1, true, yes (case-insensitive) to enable; any other value
# (including unset or false) leaves it off and the endpoint returns 404.

CRE_ENABLE_HEALTH=false

# Expose MyOpenCRE in the UI (GET /api/capabilities → myopencre).
# Off by default so production can roll out independently of import auth.

CRE_ENABLE_MYOPENCRE=false

# Expose Login/Logout in the UI (GET /api/capabilities → login).
# Off by default until auth routes + User model land; enable on staging first.

CRE_ENABLE_LOGIN=false

# Experimental OIE OWASP metadata agent (chat + MCP only — never CRE graph UI).
# Off by default. Uses the main app Postgres (DEV_DATABASE_URL / DATABASE_URL)
# for the agent index + pgvector. Reachable from /completion and MCP owasp_meta_* tools.
OWASP_AGENT_ENABLED=false

# Module C.1 graph filing (Automatically linked to). Off by default — leave Module C
# decisions in decision_queue for review; set true to auto-add high-confidence links.
OIE_GRAPH_FILING_ENABLED=false

# Nest REST API key (https://nest.owasp.org — create via GraphQL while logged in)
NEST_API_KEY=
NEST_API_BASE=https://nest.owasp.org/api/v0
# Set to 1 to crawl all www-chapter / www-project repos during sync (slow).
OWASP_AGENT_CRAWL_REPOS=0

# Embeddings

NO_GEN_EMBEDDINGS=false

# Google Auth

GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_SECRET_JSON=path/to/secret.json
LOGIN_ALLOWED_DOMAINS=example.com

# GCP / Gemini (optional — any LiteLLM provider works for Module B)

GCP_NATIVE=false
GEMINI_API_KEY=your-gemini-api-key
VERTEX_CHAT_MODEL=gemini-2.5-flash
VERTEX_EMBED_CONTENT_MODEL=gemini-embedding-001

# Other chat providers (LiteLLM). Set the key that matches CRE_NOISE_FILTER_LLM_MODEL.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# MISTRAL_API_KEY=...
# OPENROUTER_API_KEY=...

# Noise / Relevance Filter (Module B) — LiteLLM model id (provider/model)
# Examples: gemini/gemini-2.5-flash-lite | openai/gpt-4o-mini |
#           anthropic/claude-haiku-4-5 | groq/llama-3.3-70b-versatile
# Any chat model LiteLLM supports; mid-size models usually work best
# (cheap + reliable for this classify gate — avoid tiny completion stubs).

CRE_NOISE_FILTER_LLM_MODEL=gemini/gemini-2.5-flash-lite
CRE_NOISE_FILTER_BATCH_SIZE=10
CRE_NOISE_FILTER_MAX_CHARS=1500
CRE_NOISE_FILTER_CONFIDENCE_THRESHOLD=0.8

# Spreadsheet Auth

OpenCRE_gspread_Auth=path/to/credentials.json

# Module C — The Librarian (defaults match the OIE design doc; see
# application/utils/librarian/config_loader.py for validation)

# Retrieval backend: in_memory (sklearn cosine; SQLite dev/CI/harness) or
# pgvector (Postgres ``embedding_vec`` after Alembic c7d8e9f0a1b2 / #977).
CRE_LIBRARIAN_RETRIEVER_BACKEND=in_memory
# Candidate shortlist size produced by C.1 and reranked by C.2 (W4).
CRE_LIBRARIAN_TOP_K_RETRIEVAL=20
CRE_LIBRARIAN_TOP_K_RERANK=5
# Cross-encoder reranker model (W4), pinned.
CRE_LIBRARIAN_CROSSENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Auto-link confidence threshold; below this -> human review (W5).
CRE_LIBRARIAN_LINK_THRESHOLD=0.8
CRE_LIBRARIAN_BATCH_SIZE=32
CRE_LIBRARIAN_ECE_TARGET=0.10
CRE_LIBRARIAN_CONFORMAL_ALPHA=0.10

# --- OWASP agent answers: ingestion-time comprehension (#1158) ---------------------------
# Values below are the measured winning combination on staging (full 589-question set:
# whole-project context 57.6% correct vs 54.7% with no flags, ~20 s end to end). Every new
# feature is off in code unless its flag is set, so production behaves as before without them.
# Retrieval depth for the OWASP agent lane (default 8) and for comprehension documents.
OWASP_AGENT_TOP_K=16
OWASP_COMPREHENSION_TOP_K=24
# Answer from ingestion-time comprehension documents; say "not found" instead of guessing.
OWASP_COMPREHENSION_ENABLED=1
OWASP_COMPREHENSION_ABSTAIN=1
# How many retrieved documents the answer reads (more did not help: 24 scored the same as 10).
OWASP_COMPREHENSION_SOURCES=10
# Search only "raw" source chunks or only "digest" documents (default all). Raw chunks alone
# score within ~3 points of all, which is the cheap full-import option.
OWASP_COMPREHENSION_DOCS=all
# Model that writes the final answer ('' = the default chat model). Gemini Pro did not help.
OWASP_COMPREHENSION_MODEL=
# Scope retrieval to the project named in the question as a score boost. Hurt (-10 points): keep 0.
OWASP_COMPREHENSION_SCOPE=0
# Half-precision HNSW vector search. Needs migration e5f6a7b8c9d0 (the index); 1 cuts ~10 s
# of database time per question on a large embeddings table.
OWASP_PGVECTOR_HALFVEC=0

# Feature flags (1 = on). Measured on the 252-question sample unless noted.
# L4 whole-project context: when a question names exactly one project that fits, the model
# reads the project's whole text instead of snippets (+3 points on the full set).
OWASP_CX_LONGCTX=1
# Max characters of one project to read whole.
OWASP_CX_LONGCTX_CHARS=2000000
# How many named projects to read whole at once (questions naming more fall back to retrieval).
# 1 scored 59.1% on the sample; 3 scored 56.3% (counts and multi-part got worse), so keep 1.
OWASP_CX_LONGCTX_PROJECTS=1
# Off: hybrid keyword search (-2.5 points, +5 s), rerank (-2), query rewrite (-3), verify
# (+/-3, hurts with LONGCTX), per-project (0), expand (+1, noise), count (+1, slower),
# merged single call (-13, loses citations), in-process answer cache (real traffic only).
# Final-answer model with thinking off (latency); multi-part questions answered part by part.
OWASP_CX_FAST=0
# Thinking budget for the final answer: '' (model default), low, medium or high. Measured: low and
# medium are NOT faster than the default (~7 s); only OWASP_CX_FAST=1 (thinking off, 2.5 s but
# 49% on the sample, 54% with OWASP_COMPREHENSION_MODEL=gemini/gemini-2.5-flash-lite) is.
OWASP_CX_THINK_EFFORT=
OWASP_CX_DECOMPOSE=0
OWASP_CX_HYBRID=0
OWASP_CX_RERANK=0
OWASP_CX_QUERY=0
OWASP_CX_VERIFY=0
OWASP_CX_PERPROJECT=0
OWASP_CX_EXPAND=0
OWASP_CX_COUNT=0
OWASP_CX_MERGED=0
OWASP_CX_CACHE=0
# Cheap model used by the rerank/query/verify helpers when those flags are on.
OWASP_CX_HELPER_MODEL=gemini/gemini-2.5-flash-lite

# Ingestion (scripts/comprehend_standard.py): bulk digests and chunk enrichment use a cheap
# model with thinking off; repo overviews use a stronger one. Run with --estimate first.
CRE_COMPREHENSION_BULK_MODEL=gemini/gemini-2.5-flash
CRE_COMPREHENSION_OVERVIEW_MODEL=gemini/gemini-2.5-pro
CRE_COMPREHENSION_ENRICH_MODEL=gemini/gemini-2.5-flash-lite
CRE_COMPREHENSION_THINKING=off

# Warm the answer path in the background at server start (the first question after a restart
# otherwise takes ~30 s). 0 disables.
OWASP_WARMUP=1

# Remote MCP server: how many questions may be answered at the same time (each in its own thread).
OPENCRE_MCP_ASK_CONCURRENCY=8

# --- Accounts and roles (web chatbot and MCP share one model; see docs/roles.md) ---
# Two roles: "user" = any account on an allowed domain; "admin" = the named accounts below.
# Leave ADMIN_EMAILS unset for the old behaviour (LOGIN_ALLOWED_EMAILS is the one allowlist, all admins).
# ADMIN_EMAILS=alice@owasp.org,bob@owasp.org
# LOGIN_ALLOWED_DOMAINS=owasp.org
